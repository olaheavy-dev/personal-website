{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make format-check)",
      "Bash(make typecheck)",
      "Bash(make build)",
      "Bash(make budget)",
      "Bash(make e2e)",
      "Bash(make coverage)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push -u origin test/*)",
      "Bash(git push origin test/*)",
      "Bash(git push -u origin refactor/*)",
      "Bash(git push origin refactor/*)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm install *)",
      "Bash(pnpm update *)",
      "Bash(pnpm remove *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx *)",
      "Bash(supabase *)",
      "Bash(docker push *)",
      "Bash(gh pr merge *)",
      "Bash(gh api -X PATCH *)",
      "Bash(gh api -X PUT *)",
      "Bash(gh api -X POST *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method PATCH *)",
      "Bash(gh api --method PUT *)",
      "Bash(gh api --method POST *)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh repo edit *)"
    ],
    "deny": [
      "Bash(cat *.env*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.local/**)",
      "Bash(git add *supporting-documents*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push * refs/heads/main *)",
      "Bash(git push * refs/heads/main)",
      "Bash(git push * +*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git -C * push *)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push *:*)",
      "Bash(git push origin * *)",
      "Bash(git push -u origin * *)"
    ]
  }
}
