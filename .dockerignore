# Only what `next build` needs enters the build context. Private material and
# local state never do (decisions 0003 and 0010); scripts/check-image.sh
# double-checks the finished image.
.git
.github
.claude
.design
.local
supporting-documents
node_modules
.next
.artifacts
coverage
playwright-report
test-results
blob-report
e2e
docs
deploy
supabase
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.md
Dockerfile
.dockerignore
# Test-only config: it imports e2e fixtures, which are not in the build context.
playwright.config.ts
# Tests are never part of the image, and some import e2e fixtures that are not in the context.
**/*.test.ts
**/*.test.tsx
**/*.test.mts
**/*.test.mjs
vitest*.config.ts
vitest.server-only-stub.ts
