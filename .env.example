# Copy to .env.local for development. Never commit real values.

# Public contact address shown on the site's "Email me" button.
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Supabase (added with the "Supabase schema + typed data layer" task)
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# SUPABASE_SERVICE_ROLE_KEY=<server only>

# Hashnode (Writing)
# HASHNODE_PUBLICATION_HOST=<your-publication>.hashnode.dev
# HASHNODE_WEBHOOK_SECRET=<secret>

# Ask Sunkanmi assistant
# ANTHROPIC_API_KEY=<server only>
# ASSISTANT_MONTHLY_SPEND_CAP_USD=<number>
