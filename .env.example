# Copy to .env.local for development. Never commit real values.

# Public contact address shown on the site's "Email me" button.
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Supabase (see docs/database.md). The two NEXT_PUBLIC_ values are written into the build:
# locally they come from .env.local; in CI they are GitHub Actions variables (docs/deploy.md). The legacy anon and service role keys are not supported.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<from the dashboard>
# Server only: never prefix it with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=sb_secret_<from the dashboard>

# Hashnode (Writing)
# HASHNODE_PUBLICATION_HOST=<your-publication>.hashnode.dev
# HASHNODE_WEBHOOK_SECRET=<secret>

# Ask Sunkanmi assistant
# OPENAI_API_KEY=<server only>
# VOYAGE_API_KEY=<server only>
# ASSISTANT_MONTHLY_SPEND_CAP_USD=<number>

# Developer demo pages such as /_lab/route. Leave unset everywhere except local
# development and tests (Playwright sets it itself); the live site answers 404.
# LAB_PAGES=1
