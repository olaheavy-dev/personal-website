# Dependencies
/node_modules
/.pnp
.pnp.*

# Next.js build output
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# Test and tool output
/coverage
/.artifacts/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Visual regression baselines: only Linux images (made in CI) are committed
/e2e/__screenshots__/*-darwin.png
/e2e/__screenshots__/*-win32.png

# Environment files: only the example is committed
.env*
!.env.example

# Private source material: stays on the owner's machine (decision 0010)
/supporting-documents/
/.local/

# OS and editor
.DS_Store
*.pem
.vercel
npm-debug.log*
.pnpm-debug.log*
